@startuml propdevelopment-containers-smart-home
!include <C4/C4_Container>

title C4 Containers — PropDevelopment (Smart Home integration)
LAYOUT_LEFT_RIGHT()

Person(customer, "Клиент", "Подбирает и бронирует недвижимость.")
Person(owner, "Собственник", "Использует мобильные сервисы ЖКУ и управления умным домом.")
Person(manager, "Менеджер", "Работает с клиентами и объектами недвижимости, администрирует онлайн-сделки.")
Person(accountant, "Бухгалтер", "Ведёт финансовый учёт.")
Person(bi_analyst, "Аналитик BI", "Анализирует данные и готовит отчётность.")

System_Ext(utility_provider, "Поставщик ресурсов ЖКХ", "Внешняя система управляющей компании.")
System_Ext(payment_provider, "Платёжная система", "Провайдер онлайн-платежей.")
System_Ext(registration_authorities, "Государственные регистрационные органы", "Выполняют регистрационные действия с объектами недвижимости.")
System_Ext(smart_home_partner, "Платформа партнёра «Умный дом»", "Внешняя платформа управления домофонами и шлагбаумами.")
System_Ext(intercom, "Интеллектуальный домофон", "Выполняет вызов и распознавание лица по разрешениям.")
System_Ext(barrier, "Интеллектуальный шлагбаум", "Распознаёт номер автомобиля и управляет въездом.")

System_Boundary(propdevelopment, "PropDevelopment") {
    Container(sales_storefront, "Витрина продаж", "JavaScript, React", "Подбор и бронирование объектов недвижимости.")
    Container(client_crm, "client-crm-app", "Dynamics CRM / Spring Boot (уточнить)", "Управляет клиентскими данными.")
    ContainerDb(client_crm_db, "crm-db", "MSSQL", "База данных клиентской CRM.")
    Container(client_tour, "client-tour-app", "Kotlin, Spring Boot", "Проведение онлайн-тура по объекту.")
    ContainerDb(client_tour_db, "client-tour-db", "PostgreSQL", "Данные онлайн-туров.")
    Container(client_mart, "client-mart-app", "Kotlin, Spring Boot", "Данные об объектах и проведение онлайн-сделок.")
    ContainerDb(client_mart_db, "client-mart-db", "PostgreSQL", "Данные объектов и сделок.")
    Container(client_estate, "client-mart-estate-app", "Kotlin, Spring Boot", "Управление информацией об объектах недвижимости.")
    ContainerDb(client_estate_db, "client-mart-estate-db", "PostgreSQL", "Данные объектов недвижимости.")
    Container(auth_service, "auth-service-1", "Keycloak", "Аутентификация покупателей; применение для собственников требует подтверждения.")
    ContainerDb(auth_db, "auth-db-1", "PostgreSQL", "Хранилище учётных записей сервиса аутентификации.")

    Container(owner_mobile, "Витрина сервисов для собственников", "Мобильное приложение iOS / Android", "Существующее приложение, через которое доступны функции ЖКУ и умного дома.")
    Container(tenant_core, "tenant-core-app", "Kotlin, Spring Boot", "Предоставление услуг собственникам; backend-точка входа для операций умного дома.")
    ContainerDb(tenant_db, "tenant-core-db", "PostgreSQL", "База данных услуг ЖКУ по собственникам.")
    Container(owner_crm, "CRM", "Kotlin, Spring Boot", "Управление данными собственников и проверка связи пользователя с объектом.")
    ContainerDb(owner_crm_db, "crm-tenant-db", "PostgreSQL", "База данных CRM собственников.")
    Container(smart_home_service, "Smart Home Integration Service", "Kotlin, Spring Boot", "Новый сервис: проверяет права на объект/устройство, вызывает API партнёра, принимает события и ведёт аудит. Не хранит биометрические шаблоны.")
    ContainerDb(smart_home_db, "smart-home-db", "PostgreSQL", "Новая БД минимальных связей собственник—объект—устройство, согласий, разрешений и метаданных аудита.")

    Container(accountant_service, "accountant-service-1", "Технология требует уточнения", "Система финансового учёта; в исходной C4-модели указана технология Keycloak.")
    Container(finance_directory, "Active Directory (финансы)", "Microsoft Active Directory", "Служба каталогов для финансовых сервисов.")
    Container(business_directory, "Active Directory (бизнес-системы и данные)", "Microsoft Active Directory", "Служба каталогов для прикладных и аналитических систем.")
    Container(dwh, "Хранилище данных", "Greenplum", "Единое хранилище данных систем компании.")
    ContainerDb(dwh_object_storage, "DWH Хранилище", "S3", "Физическое хранилище данных DWH.")
    Container(bi_reporting, "BI и отчётность", "Технология не указана", "Анализ и представление корпоративных данных.")
}

Rel(customer, sales_storefront, "Подбирает и бронирует недвижимость", "HTTPS")
Rel(sales_storefront, client_crm, "Регистрация и профиль клиента", "REST")
Rel(sales_storefront, client_mart, "Бронирование и онлайн-сделка", "REST")
Rel(sales_storefront, client_estate, "Получение данных по объектам", "REST")
Rel(sales_storefront, client_tour, "Запуск онлайн-тура", "REST")
Rel(client_crm, client_crm_db, "Читает и записывает клиентские данные", "JDBC")
Rel(client_tour, client_tour_db, "Читает и записывает данные тура", "JDBC")
Rel(client_mart, client_mart_db, "Читает и записывает данные сделки", "JDBC")
Rel(client_estate, client_estate_db, "Читает и записывает данные объектов", "JDBC")
Rel(client_crm, client_mart, "Публикует каталог объектов", "Kafka")
Rel(client_mart, registration_authorities, "Передаёт сведения для регистрации", "СМЭВ / SOAP")
Rel(sales_storefront, auth_service, "Аутентификация покупателей", "REST / OIDC")
Rel(auth_service, auth_db, "Читает и записывает учётные записи", "JDBC")
Rel(manager, client_crm, "Работает с клиентскими данными", "HTTPS")
Rel(manager, client_mart, "Администрирует онлайн-сделки", "HTTPS")

Rel(owner, owner_mobile, "Использует приложение", "HTTPS")
Rel(owner_mobile, auth_service, "Аутентификация; проверить охват собственников", "OIDC")
Rel(owner_mobile, tenant_core, "Запрашивает услуги и функции умного дома", "REST / WebSocket over TLS")
Rel(tenant_core, tenant_db, "Читает и записывает данные ЖКУ", "JDBC")
Rel(tenant_core, owner_crm, "Проверяет связь собственника с объектом", "Внутренний REST API")
Rel(owner_crm, owner_crm_db, "Читает и записывает данные собственников", "JDBC")
Rel(tenant_core, utility_provider, "Получает сведения и предоставляет услуги ЖКУ", "Внешний API")
Rel(tenant_core, payment_provider, "Инициирует и проверяет оплату", "Внешний API")
Rel(tenant_core, smart_home_service, "Передаёт запрос после первичной проверки пользователя", "Внутренний REST API")
Rel(smart_home_service, owner_crm, "Подтверждает принадлежность объекта и разрешения", "Внутренний REST API")
Rel(smart_home_service, smart_home_db, "Хранит минимальные разрешения, согласия и статусы", "JDBC")
Rel(smart_home_service, smart_home_partner, "Передаёт команды и разрешённые данные", "HTTPS API, mTLS + OAuth 2.0 Client Credentials")
Rel(smart_home_partner, smart_home_service, "Возвращает статусы и события", "Подписанный callback или polling")
Rel(smart_home_partner, intercom, "Управляет домофоном; биометрия обрабатывается на стороне партнёра", "API производителя")
Rel(smart_home_partner, barrier, "Синхронизирует разрешённые номера и команды", "API производителя")

Rel(accountant, accountant_service, "Ведёт финансовый учёт", "Внутренний доступ")
Rel(accountant_service, finance_directory, "Аутентификация бухгалтеров", "Каталог учётных записей")
Rel(client_crm_db, dwh, "Передаёт данные", "CDC")
Rel(client_mart_db, dwh, "Передаёт данные", "CDC")
Rel(client_estate_db, dwh, "Передаёт данные", "CDC")
Rel(owner_crm_db, dwh, "Передаёт данные", "CDC")
Rel(tenant_db, dwh, "Передаёт данные", "CDC")
Rel(dwh, dwh_object_storage, "Сохраняет наборы данных", "S3")
Rel(bi_analyst, bi_reporting, "Формирует отчётность", "Внутренний доступ")
Rel(bi_reporting, dwh, "Читает данные для анализа", "Внутренний API")
Rel(bi_reporting, business_directory, "Аутентификация аналитиков", "Каталог учётных записей")

SHOW_LEGEND()
@enduml
