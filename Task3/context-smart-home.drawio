<mxfile host="app.diagrams.net" version="24.8.0">
  <diagram id="smart-home-context" name="Контекст умного дома">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="owner-to-system" value="Использует мобильное приложение&#xa;для вызова и управления доступом" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="owner" target="propdevelopment"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="system-to-partner" value="Передаёт минимальные права доступа,&#xa;команды открытия и запросы статуса&#xa;[защищённый API]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="propdevelopment" target="partner"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="partner-to-system" value="Передаёт статусы устройств и события&#xa;[подписанный callback или polling]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="partner" target="propdevelopment"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="520" as="sourcePoint" /><mxPoint x="900" y="650" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="partner-to-intercom" value="Управление и настройка разрешённого доступа" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="partner" target="intercom"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="partner-to-barrier" value="Синхронизация списка разрешённых номеров&#xa;и получение статуса" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="partner" target="barrier"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="intercom-to-partner" value="Событие вызова / результат распознавания&#xa;(обработка биометрии на стороне партнёра)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="intercom" target="partner"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="barrier-to-partner" value="Событие распознавания номера / состояние шлагбаума" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="barrier" target="partner"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="title" value="C4 — контекст новых функций «Умный дом»" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1f1f1f;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="50" as="geometry" /></mxCell>
        <mxCell id="owner" value="Собственник&#xa;[Person]&#xa;Управляет доступом к дому и автомобилю через мобильное приложение." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0b5394;strokeColor=#073763;fontColor=#ffffff;fontSize=14;" vertex="1" parent="1"><mxGeometry x="50" y="360" width="240" height="130" as="geometry" /></mxCell>
        <mxCell id="propdevelopment" value="PropDevelopment — сервисы для собственников&#xa;[Software System]&#xa;Мобильная витрина, сервисы ЖКУ и новые функции управления умным домом. Проверяет личность, право на объект и полномочия перед передачей команды партнёру." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=15;" vertex="1" parent="1"><mxGeometry x="460" y="330" width="450" height="190" as="geometry" /></mxCell>
        <mxCell id="partner" value="Платформа партнёра «Умный дом»&#xa;[External Software System]&#xa;Предоставляет API, обрабатывает разрешённые команды и управляет устройствами. Обработка биометрии выполняется на стороне партнёра согласно согласованной модели данных." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8c8496;strokeColor=#736782;fontColor=#ffffff;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1080" y="330" width="360" height="190" as="geometry" /></mxCell>
        <mxCell id="intercom" value="Интеллектуальный домофон&#xa;[Device]&#xa;Вызов, разрешение на вход, распознавание лица по правилам партнёра." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a6a6a6;strokeColor=#666666;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="650" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="barrier" value="Интеллектуальный шлагбаум&#xa;[Device]&#xa;Открытие для автомобиля, номер которого разрешён для объекта." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a6a6a6;strokeColor=#666666;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1100" y="820" width="300" height="110" as="geometry" /></mxCell>

        <mxCell id="note" value="Граница доверия: собственник и мобильное приложение не вызывают платформу партнёра напрямую. PropDevelopment проверяет tenant/object-level права и ведёт аудит; партнёр получает только минимальные данные для конкретного дома и устройства." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="120" width="1040" height="100" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
